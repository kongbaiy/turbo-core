{
    "name": "cloud-core",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.0.5",
    "scripts": {
        "build": "turbo run build",
        "build:test": "vite build --mode test",
        "dev": "turbo run dev",
        "local": "turbo run local --concurrency=20 --filter sc-cloud-basic --filter sc-cloud-basic-platform --filter sc-cloud-platform --filter sc-cloud-fm-budget --filter sc-cloud-design-form --filter sc-cloud-fm-treasury --filter sc-cloud-fm-accounting --filter sc-cloud-mdm --filter sc-cloud-procurement --filter sc-cloud-expense --filter sc-cloud-contract --filter sc-cloud-hr",
        "lint": "turbo run lint",
        "test": "vitest",
        "test:run": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "format": "prettier --write \"**/*.{js,ts,jsx,tsx,css,scss,html,md}\"",
        "check-types": "turbo run check-types",
        "preinstall": "npx only-allow pnpm",
        "postinstall": "husky",
        "prepare": "husky",
        "lint:eslint": "eslint . --fix",
        "lint:stylelint": "stylelint \"**/*.{css,scss}\" --fix",
        "clone": "node ./clone/index.ts",
        "clone-npx": "npx tsx ./clone/index.ts"
    },
    "dependencies": {
        "@amap/amap-react": "^0.1.5",
        "@ant-design/icons": "^6.2.3",
        "@ant-design/pro-components": "3.1.12-0",
        "@wangeditor/editor": "^5.1.23",
        "@wangeditor/editor-for-react": "^1.0.6",
        "antd": "^6.4.3",
        "axios": "^1.16.1",
        "core-js": "^3.49.0",
        "file-saver": "^2.0.5",
        "html-docx-js-typescript": "^0.1.5",
        "mobx": "^7.0.0",
        "react": "^19.2.6",
        "react-activation": "^0.13.4",
        "react-dom": "^19.2.6",
        "react-router-dom": "^7.15.1"
    },
    "devDependencies": {
        "@playwright/test": "1.61.1",
        "@repo/antd-theme": "workspace:*",
        "@repo/commitlint-config": "workspace:*",
        "@repo/enterprise-organization": "workspace:*",
        "@repo/eslint-config": "workspace:*",
        "@repo/permission-navigation": "workspace:*",
        "@repo/pro-components": "workspace:*",
        "@repo/react-components": "workspace:*",
        "@repo/react-hooks": "workspace:*",
        "@repo/stylelint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@repo/unocss-config": "workspace:*",
        "@repo/utils": "workspace:*",
        "@repo/vite-config": "workspace:*",
        "@repo/stores": "workspace:*",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^3.2.7",
        "esbuild": "0.27.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^15.2.10",
        "msw": "^2.15.0",
        "postcss-html": "^1.8.1",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.8.3",
        "sass": "^1.99.0",
        "turbo": "^2.9.14",
        "typescript": "5.9.2",
        "unbuild": "^3.6.1",
        "vitest": "^3.2.7"
    },
    "engines": {
        "node": "22.22.3"
    },
    "volta": {
        "node": "22.22.3"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "lint-staged": {
        "*.{vue,js,jsx}": "eslint --fix --max-warnings 0 --no-warn-ignored",
        "*.{json,md}": "eslint --fix --max-warnings 0 --no-warn-ignored",
        "*.{css,scss}": "stylelint --fix",
        "*.{ts,tsx}": "bash -c './node_modules/.bin/tsc --noEmit -p tsconfig.json'"
    }
}
