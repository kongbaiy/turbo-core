{
    "editor.formatOnSave": true,
    "npm.packageManager": "pnpm",

    // Auto fix
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "never",
        "source.fixAll.stylelint": "explicit"
    },

    // eslint 配置
    "eslint.format.enable": true,
    "eslint.probe": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "html",
        "vue",
        "markdown",
        "json",
        "jsonc"
    ],
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "html",
        "vue",
        "markdown",
        "json",
        "jsonc"
    ],

    // stylelint 配置
    "stylelint.enable": true,
    "stylelint.validate": [
        "css",
        "less",
        "postcss",
        "scss",
        "vue",
        "sass",
        "html",
        "react",
        "jsx",
        "tsx"
    ],

    // unocss 配置
    "scss.lint.unknownAtRules": "ignore",
    "css.lint.unknownAtRules": "ignore",
    "less.lint.unknownAtRules": "ignore",

    "files.eol": "\n",

    "cSpell.words": [
        "amap",
        "antd",
        "Apifox",
        "Appstore",
        "CASCADER",
        "commitlint",
        "cssinjs",
        "excludesfile",
        "geekblue",
        "microapps",
        "njsproj",
        "ntvs",
        "officedocument",
        "openxmlformats",
        "Popconfirm",
        "PREFIXS",
        "qiankun",
        "serviceworker",
        "sider",
        "Siderbar",
        "spreadsheetml",
        "stylelintignore",
        "subapp",
        "thirdparty",
        "TOPBAR",
        "Turborepo",
        "umijs",
        "unocss",
        "unplugin",
        "Usergroup",
        "Vercel",
        "vite",
        "wangeditor",
        "Wechat",
        "WXWORK"
    ],

    // 格式化配置
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },

    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },

    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // 终端配置
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },

    // git
    "git.autoRepositoryDetection": true,
    "git.repositoryScanMaxDepth": 2,
    "git.openRepositoryInParentFolders": "always"
}
